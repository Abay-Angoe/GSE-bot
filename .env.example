# Copy this file to ".env" and fill in your values. Do not commit .env.

# Telegram (see build brief section 6):
#   1. Message @BotFather -> /newbot -> copy the bot token below.
#   2. Send any message to your new bot, then open:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      and read the chat id (or use @userinfobot).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: LLM-based IPO classification (filters false positives).
# Set the provider in config.yaml (ipo_watcher.llm_provider); fill the matching key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
